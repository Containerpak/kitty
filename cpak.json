{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Kitty",
  "description": "A GPU-accelerated terminal emulator with tabs and layouts.",
  "version": "0.45.0",
  "image": "ghcr.io/containerpak/kitty@sha256:5c6e7f7cd1a0c3a66fad9e38d7d121b2239ea1eadd27fce8b3371f7892f09e58",
  "binaries": [
    "/usr/bin/kitty",
    "/usr/bin/kitten"
  ],
  "desktop_entries": [
    "/usr/share/applications/kitty.desktop"
  ],
  "dependencies": [],
  "addons": [
    "github.com/containerpak/sdk-go",
    "github.com/containerpak/sdk-node-lts"
  ],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
