{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Kitty",
  "description": "A GPU-accelerated terminal emulator with tabs and layouts.",
  "version": "0.45.0",
  "image": "ghcr.io/containerpak/kitty@sha256:857758b026418b6644ba4e3c3cd26f5f64f79fe3fb3b74df58ab6d3a989b4623",
  "binaries": [
    "/usr/bin/kitty",
    "/usr/bin/kitten"
  ],
  "desktop_entries": [
    "/usr/share/applications/kitty.desktop"
  ],
  "dependencies": [],
  "addons": [
    "github.com/containerpak/sdk-go",
    "github.com/containerpak/sdk-node-lts"
  ],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
